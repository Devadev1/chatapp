# Copy to .env and load it however you like, e.g.:  set -a; . ./.env; set +a; node server.js

# Public URL users type in the browser (no trailing slash). Must be https:// for phones / production.
BASE_URL=http://localhost:3000
PORT=3000

# ── SSO (any OpenID Connect provider) ──
# Register this redirect URI with your provider:  ${BASE_URL}/auth/callback
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Google            # label on the login button
# OIDC_SCOPES=openid email profile

# Optional: only let these email domains in (comma separated)
# ALLOWED_EMAIL_DOMAINS=example.com,example.org

# Demo login (no real SSO). Defaults to ON only when OIDC_CLIENT_ID is empty. Keep 0 in production.
# DEV_LOGIN=0

# Optional: stable cookie-signing secret (otherwise generated into data/secret.key)
# SESSION_SECRET=
# DATA_DIR=./data

# Optional: WebRTC STUN/TURN server configuration (JSON array, exposed to signed-in browsers).
# Use short-lived or scoped TURN credentials; the default is Google's public STUN server.
# RTC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"...","credential":"..."}]
